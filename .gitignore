# Workspace .gitignore — covers frontend and backend

# Node
**/node_modules/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
**/dist/
**/build/
**/out/
/.next/
/.vercel/

# TypeScript
*.tsbuildinfo

# Environment files (do not commit secrets)
.env
.env.*.local
.env.local
frontend/.env
backend/.env

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Test coverage
/coverage/

# Next.js cache and artifacts
.next/
.turbo/
.parcel-cache/

# Misc
*.log
*.sqlite
*.sqlite3
logs/
tmp/
temp/
*.seed

# Docker
docker-compose.override.yml

# Yarn PnP
.pnp.*

# Ignore local env for editors
/.env.local
