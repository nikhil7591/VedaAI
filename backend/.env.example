# ── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── MongoDB Atlas ─────────────────────────────────────────────────────
# Get this from: MongoDB Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/vedaai?retryWrites=true&w=majority

# ── Upstash Redis ─────────────────────────────────────────────────────
# Get this from: Upstash Console → Redis → Details → "ioredis" URL
# Format: rediss://default:<token>@<host>.upstash.io:6379
REDIS_URL=rediss://default:<token>@<host>.upstash.io:6379

# ── Groq ──────────────────────────────────────────────────────────────
# Get from: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# llama-3.1-70b-versatile (default, supports JSON mode)
# Other options: mixtral-8x7b-32768, llama3-70b-8192, gemma2-9b-it
LLM_MODEL=llama-3.1-70b-versatile

# ── CORS ──────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Cache ─────────────────────────────────────────────────────────────
REDIS_TTL_PAPER=3600
